<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="4dp"
    android:paddingVertical="2dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/categoryIconImageView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:lines="1"
        android:maxLines="1"
        android:src="@drawable/circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="4dp"
        app:tint="#c00000" />
    <TextView
        android:id="@+id/categoryTitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginHorizontal="12dp"
        android:maxLines="1"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:paddingVertical="4dp"
        android:text="Category Name"
        app:layout_constraintTop_toTopOf="@id/categoryAmountTextView"
        app:layout_constraintBottom_toBottomOf="@id/categoryAmountTextView"
        app:layout_constraintLeft_toRightOf="@id/categoryIconImageView"
        android:textColor="@color/normal_text_color"
        />
    <TextView
        android:id="@+id/categoryAmountTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:padding="4dp"
        android:text="Category Name"
        android:drawablePadding="8dp"
        app:drawableStartCompat="@drawable/rupee_sign_svgrepo_com_12px"
        app:drawableTint="@color/icon_color_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/spendTitleValueProgressbarId"
        android:layout_margin="2dp"
        android:textColor="@color/normal_text_color"
        />
    <ImageView
        android:id="@+id/factorValueId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/categoryAmountTextView"
        app:layout_constraintRight_toRightOf="@id/categoryAmountTextView"
        app:layout_constraintBottom_toBottomOf="@id/slashTextViewId"
        android:src="@drawable/danger_triangle_svgrepo_com"
        android:gravity="center"
        android:minEms="2"
        android:textColor="@color/white"
        android:paddingHorizontal="4dp"
        app:tint="@color/fab_bg_color" />
    <TextView
        android:id="@+id/monthlyAmountLimitId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/spendTitleValueProgressbarId"
        app:layout_constraintRight_toRightOf="@id/spendTitleValueProgressbarId"
        android:gravity="center"
        android:textSize="12sp"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:textColor="@color/normal_text_color"
        android:paddingHorizontal="2dp"/>
    <TextView
        android:id="@+id/slashTextViewId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/spendTitleValueProgressbarId"
        app:layout_constraintRight_toLeftOf="@id/monthlyAmountLimitId"
        android:gravity="center"
        android:text="/"
        android:textSize="12sp"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:paddingHorizontal="4dp"
        android:textColor="@color/normal_text_color" />
    <TextView
        android:id="@+id/categoryAmountTextView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/spendTitleValueProgressbarId"
        app:layout_constraintRight_toLeftOf="@id/slashTextViewId"
        android:gravity="center"
        android:textSize="12sp"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:textColor="@color/normal_text_color"
        android:paddingHorizontal="2dp"/>

    <ProgressBar
        android:layout_marginVertical="0dp"
        android:layout_marginEnd="8dp"
        android:id="@+id/spendTitleValueProgressbarId"
        android:layout_width="0dp"
        android:layout_height="4dp"
        style="?android:attr/progressBarStyleHorizontal"
        android:progressDrawable="@drawable/custom_progress_bar"
        android:indeterminate="false"
        android:max="100"
        android:progress="95"
        android:visibility="visible"
        app:layout_constraintLeft_toLeftOf="@id/categoryTitleTextView"
        app:layout_constraintRight_toLeftOf="@id/factorValueId"
        app:layout_constraintTop_toBottomOf="@id/categoryTitleTextView"
        />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:background="@color/divider_bg_primary"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/slashTextViewId"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>