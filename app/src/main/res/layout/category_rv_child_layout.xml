<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constraintLayoutId"
    android:layout_width="wrap_content"
    android:background="@color/card_view_light_bg"
    android:minHeight="150dp"
    android:minWidth="100dp" android:layout_height="match_parent">

    <ImageView
        android:layout_marginVertical="8dp"
        android:padding="4dp"
        android:id="@+id/iconImageView"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/iconTextView"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/circle"
        android:backgroundTint="@color/divider_color_bg"
        />
    <!-- TextView inside the ConstraintLayout -->
    <TextView
        android:id="@+id/iconTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Title"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:textColor="@color/card_view_font_color"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iconImageView"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="center_vertical"
        android:lines="1"
        android:maxLength="20"
        />

    <!-- Vertical Divider -->
    <View
    android:id="@+id/verticalDivider"
    android:layout_width="1dp"
    android:layout_height="0dp"
    android:background="@color/divider_color_bg"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <!-- Horizontal Divider -->
    <View
        android:id="@+id/horizontalDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/divider_color_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
