<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainId"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbarId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/window_appbar_bg_color"
        android:gravity="center_vertical"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_scrollFlags="scroll|enterAlways|snap">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title="Create a Folder"
            app:titleCentered="true"
            app:titleTextAppearance="@style/CustomToolbarTitle"
            app:titleTextColor="@color/title_font_color" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/appbarId"
        app:layout_constraintBottom_toTopOf="@id/colorImageViewId"
        android:paddingVertical="0dp"
        android:layout_marginVertical="2dp"
        android:layout_marginHorizontal="32dp">
        <TextView
            android:textSize="16sp"
            android:id="@+id/clubTitleId"
            android:layout_width="wrap_content"
            android:fontFamily="@font/quicksand_medium"
            android:letterSpacing="0.1"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginVertical="2dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/clubCardViewId"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:text="Preview -" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/clubCardViewId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:elevation="0dp"
            app:cardCornerRadius="64dp"
            android:outlineSpotShadowColor="@android:color/transparent"
            android:backgroundTint="@color/card_view_light_bg"
            app:layout_constraintTop_toBottomOf="@id/clubTitleId"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_marginVertical="4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clubSelectedValueId"
            android:visibility="visible"
            android:elevation="4dp"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

            <ImageView
                android:layout_marginHorizontal="4dp"
                android:elevation="4dp"
                android:padding="4dp"
                android:id="@+id/clubIconImageView"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/circle"
                android:backgroundTint="@color/purple"
                />
            <TextView
                android:id="@+id/clubTextValueId1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_medium"
                android:letterSpacing="0.1"
                android:textSize="16sp"
                android:layout_marginStart="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toLeftOf="@id/clearClubValueId"
                app:layout_constraintLeft_toRightOf="@id/clubIconImageView"
                app:layout_constraintBottom_toTopOf="@id/clubTextValueId2"
                android:text="Club Title"
                android:gravity="center_vertical"
                android:padding="2dp"
                android:maxLines="1"
                android:textColor="@color/normal_text_color"
                />
            <TextView
                android:id="@+id/clubTextValueId2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand_medium"
                android:letterSpacing="0.05"
                android:textSize="12sp"
                android:layout_marginHorizontal="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/clubTextValueId1"
                app:layout_constraintRight_toLeftOf="@id/clearClubValueId"
                app:layout_constraintLeft_toRightOf="@id/clubIconImageView"
                android:text="Subtitle Text"
                android:ellipsize="end"
                android:paddingBottom="2dp"
                android:paddingHorizontal="2dp"
                android:maxLines="1"
                android:textColor="@color/normal_text_color"
                />
                <ImageView
                    android:id="@+id/clearClubValueId"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:minWidth="24dp"
                    android:minHeight="24dp"
                    android:layout_marginHorizontal="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintDimensionRatio="1"
                    android:src="@drawable/baseline_close_24"
                    android:background="@drawable/circle"
                    app:tint="@color/icon_color_secondary"
                    />
        </androidx.constraintlayout.widget.ConstraintLayout>


        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <ImageView
        android:id="@+id/colorImageViewId"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintBottom_toTopOf="@id/clubTitleInputLayout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appbarId"
        android:background="@drawable/circle"
        android:backgroundTint="#000000"
        />

    <com.google.android.material.textfield.TextInputLayout
        app:layout_constraintRight_toRightOf="@id/saveClubId"
        app:layout_constraintBottom_toTopOf="@id/clubSubtitleInputLayout"
        android:id="@+id/clubTitleInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:hint="Club Title"
        app:hintTextColor="@color/icon_color_primary"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/clubTitleEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/baseline_edit_note_24"
            android:drawablePadding="8dp"
            android:drawableTint="@color/edittext_icon_color"
            android:imeOptions="actionDone"
            android:lines="1"
            android:maxLines="1"
            android:singleLine="true"
            android:fontFamily="@font/quicksand_medium"
            android:letterSpacing="0.1"
            android:maxLength="16"
            android:textColor="@color/edittext_font_color" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        app:layout_constraintRight_toRightOf="@id/saveClubId"
        app:layout_constraintBottom_toTopOf="@id/saveClubId"
        android:id="@+id/clubSubtitleInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:hint="Subtitle Text"
        app:hintTextColor="@color/icon_color_primary"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/clubSubtitleEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/baseline_edit_note_24"
            android:drawablePadding="8dp"
            android:drawableTint="@color/edittext_icon_color"
            android:ellipsize="end"
            android:imeOptions="actionDone"
            android:lines="1"
            android:inputType="text"
            android:maxLength="16"
            android:maxLines="1"
            android:fontFamily="@font/quicksand_medium"
            android:letterSpacing="0.1"
            android:singleLine="true"
            android:textColor="@color/edittext_font_color" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/saveClubId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:layout_margin="8dp"
        app:icon="@drawable/baseline_check_24"
        app:iconPadding="8dp"
        android:text="Save" />
    <com.google.android.material.button.MaterialButton
        android:visibility="invisible"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/deleteClubId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        app:icon="@drawable/baseline_close_24"
        app:iconPadding="8dp"
        android:text="Delete" />
</androidx.constraintlayout.widget.ConstraintLayout>