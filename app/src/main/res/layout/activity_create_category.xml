<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainId"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbarId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/window_appbar_bg_color"
        android:gravity="center_vertical"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_scrollFlags="scroll|enterAlways|snap">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title="Add Category"
            app:titleCentered="true"
            app:titleTextAppearance="@style/CustomToolbarTitle"
            app:titleTextColor="@color/title_font_color" />

    </com.google.android.material.appbar.AppBarLayout>

    <ImageView
        android:id="@+id/colorImageViewId"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintBottom_toTopOf="@id/categoryTitleInputLayout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appbarId"
        android:background="@drawable/circle"
        android:backgroundTint="#000000"
        />

    <com.google.android.material.textfield.TextInputLayout
        app:layout_constraintRight_toRightOf="@id/saveCategoryId"
        app:layout_constraintBottom_toTopOf="@id/monthlyAmountLimitInputLayout"
        android:id="@+id/categoryTitleInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:hint="Category Title"
        app:hintTextColor="@color/icon_color_primary"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/categoryTitleEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/baseline_edit_note_24"
            android:drawablePadding="8dp"
            android:drawableTint="@color/edittext_icon_color"
            android:ellipsize="end"
            android:imeOptions="actionDone"
            android:lines="1"
            android:maxLines="1"
            android:singleLine="true"
            android:fontFamily="@font/quicksand_medium"
            android:letterSpacing="0.1"
            android:maxLength="25"
            android:textColor="@color/edittext_font_color" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        app:layout_constraintRight_toRightOf="@id/saveCategoryId"
        app:layout_constraintBottom_toTopOf="@id/saveCategoryId"
        android:id="@+id/monthlyAmountLimitInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:hint="Monthly Limit"
        app:hintTextColor="@color/icon_color_primary"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/monthlyAmountLimitEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/rupee_sign_svgrepo_com"
            android:drawablePadding="8dp"
            android:drawableTint="@color/edittext_icon_color"
            android:ellipsize="end"
            android:imeOptions="actionDone"
            android:lines="1"
            android:inputType="number"
            android:maxLength="10"
            android:maxLines="1"
            android:fontFamily="@font/quicksand_medium"
            android:letterSpacing="0.1"
            android:singleLine="true"
            android:textColor="@color/edittext_font_color" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/saveCategoryId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:layout_margin="8dp"
        app:icon="@drawable/baseline_check_24"
        app:iconPadding="8dp"
        android:text="Save" />
    <com.google.android.material.button.MaterialButton
        android:visibility="invisible"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/deleteCategoryId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        app:icon="@drawable/baseline_close_24"
        app:iconPadding="8dp"
        android:text="Delete" />
</androidx.constraintlayout.widget.ConstraintLayout>