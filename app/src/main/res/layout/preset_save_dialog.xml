<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/transactionTypeTitleId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transaction Type"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textColor="@color/normal_text_color"
        android:padding="4dp"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        />
    <TextView
        android:id="@+id/transactionTypeValueId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Spend"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:paddingVertical="4dp"
        android:paddingHorizontal="8dp"
        android:backgroundTint="@color/edittext_special_bg_color"
        android:background="@drawable/sharp_rectangle_shape"
        android:textAllCaps="true"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toRightOf="@id/transactionTypeTitleId"
        app:layout_constraintBaseline_toBaselineOf="@id/transactionTypeTitleId"
        android:textColor="@color/normal_text_color"
        app:layout_constraintHorizontal_bias="0.05"
        />
    <TextView
        android:layout_marginVertical="4dp"
        android:id="@+id/transactionTypeTransferTitleId"
        android:layout_width="wrap_content"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:layout_height="wrap_content"
        android:text="Transfer"
        app:layout_constraintLeft_toLeftOf="@id/transactionTypeTitleId"
        app:layout_constraintTop_toBottomOf="@id/transactionTypeTitleId"
        android:textColor="@color/normal_text_color"
        android:padding="4dp"
        />
    <TextView
        android:id="@+id/transactionTypeTransferTypeValueId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="To"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:backgroundTint="@color/edittext_special_bg_color"
        android:paddingVertical="4dp"
        android:paddingHorizontal="8dp"
        android:background="@drawable/sharp_rectangle_shape"
        android:textAllCaps="true"
        app:layout_constraintRight_toLeftOf="@id/transactionTypeTransferValueId"
        app:layout_constraintLeft_toRightOf="@id/transactionTypeTransferTitleId"
        app:layout_constraintBaseline_toBaselineOf="@id/transactionTypeTransferTitleId"
        android:textColor="@color/normal_text_color"
        />
    <TextView
        android:id="@+id/transactionTypeTransferValueId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mayank"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:paddingVertical="4dp"
        android:backgroundTint="@color/edittext_special_bg_color"
        android:paddingHorizontal="8dp"
        android:background="@drawable/sharp_rectangle_shape"
        android:textAllCaps="true"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="@id/transactionTypeValueId"
        app:layout_constraintBaseline_toBaselineOf="@id/transactionTypeTransferTitleId"
        android:textColor="@color/normal_text_color"
        app:layout_constraintHorizontal_bias="0"
        />
    <TextView
        android:id="@+id/transactionAmountTitleId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Amount"
        app:layout_constraintLeft_toLeftOf="@id/transactionTypeTransferTitleId"
        app:layout_constraintTop_toBottomOf="@id/transactionTypeTransferTitleId"
        android:textColor="@color/normal_text_color"
        android:padding="4dp"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:layout_marginVertical="4dp"
        />
    <TextView
        android:id="@+id/transactionAmountValueId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12334546"
        android:paddingVertical="4dp"
        android:backgroundTint="@color/edittext_special_bg_color"
        android:paddingHorizontal="8dp"
        android:background="@drawable/sharp_rectangle_shape"
        android:textAllCaps="true"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:drawablePadding="8dp"
        app:drawableStartCompat="@drawable/rupee_sign_svgrepo_com_12px"
        app:drawableTint="@color/icon_color_primary"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="@id/transactionTypeValueId"
        app:layout_constraintBaseline_toBaselineOf="@id/transactionAmountTitleId"
        android:textColor="@color/normal_text_color"
        app:layout_constraintHorizontal_bias="0.00"
        />

    <TextView
        android:id="@+id/transactionCategoryTitleId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        app:layout_constraintLeft_toLeftOf="@id/transactionTypeTransferTitleId"
        app:layout_constraintTop_toBottomOf="@id/transactionAmountTitleId"
        android:textColor="@color/normal_text_color"
        android:padding="4dp"
        android:layout_marginVertical="4dp"
        />
    <TextView
        android:id="@+id/transactionCategoryValueId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Juice"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:paddingVertical="4dp"
        android:backgroundTint="@color/edittext_special_bg_color"
        android:paddingHorizontal="8dp"
        android:background="@drawable/sharp_rectangle_shape"
        android:textAllCaps="true"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="@id/transactionTypeValueId"
        app:layout_constraintBaseline_toBaselineOf="@id/transactionCategoryTitleId"
        android:textColor="@color/normal_text_color"
        app:layout_constraintHorizontal_bias="0.00"
        />
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/presetTitleInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        android:hint="Preset Name"
        app:hintTextColor="@color/normal_font_color"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        app:counterEnabled="true"
        app:counterMaxLength="16"
        app:counterTextColor="@color/normal_text_color"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transactionCategoryTitleId"
        >
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/presetTitleEditTextId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/baseline_edit_note_24"
            android:drawablePadding="8dp"
            android:drawableTint="@color/edittext_special_icon_color"
            android:ellipsize="end"
            android:fontFamily="@font/quicksand_medium"
            android:letterSpacing="0.1"
            android:imeOptions="actionDone"
            android:lines="1"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/edittext_font_color" />

    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:id="@+id/cancelPresetSavingId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:textColor="@color/normal_text_color"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/presetTitleInputLayout"
        app:layout_constraintRight_toLeftOf="@id/doPresetSavingId"/>

    <TextView
        android:id="@+id/doPresetSavingId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:textColor="@color/normal_text_color"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:layout_gravity="center"
        app:layout_constraintRight_toRightOf="@id/presetTitleInputLayout"
        app:layout_constraintTop_toBottomOf="@id/presetTitleInputLayout"/>

</androidx.constraintlayout.widget.ConstraintLayout>