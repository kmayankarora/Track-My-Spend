<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbarId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/window_appbar_bg_color"
        android:gravity="center_vertical"
        app:layout_scrollFlags="scroll|enterAlways|snap"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:theme="@style/ThemeOverlay.MaterialComponents.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title="Track My Spend"
            app:titleCentered="true"
            app:titleTextAppearance="@style/CustomToolbarTitle"
            android:theme="@style/MyActionBarTheme"
            app:titleTextColor="@color/title_font_color" />

    </com.google.android.material.appbar.AppBarLayout>

<!--    <ProgressBar-->
<!--        android:layout_marginHorizontal="16dp"-->
<!--        android:id="@+id/spendTitleValueProgressbarId"-->
<!--        android:layout_width="0dp"-->
<!--        app:layout_constraintHorizontal_weight="4"-->
<!--        android:layout_height="4dp"-->
<!--        style="?android:attr/progressBarStyleHorizontal"-->
<!--        android:progressDrawable="@drawable/custom_progress_bar"-->
<!--        android:indeterminate="false"-->
<!--        android:max="100"-->
<!--        android:progress="95"-->
<!--        android:visibility="visible"-->
<!--        app:layout_constraintRight_toRightOf="parent"-->
<!--        app:layout_constraintLeft_toRightOf="@id/CategoryInfoId"-->
<!--        app:layout_constraintTop_toTopOf="@id/CategoryInfoId"-->
<!--        app:layout_constraintBottom_toBottomOf="@id/CategoryInfoId"/>-->

    <!--Reportcard title-->
    <LinearLayout
        android:id="@+id/currentPeriodId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/appbarId"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <TextView
            android:layout_marginBottom="4dp"
            android:id="@+id/currentPeriodValueId"
            android:layout_width="0dp"
            android:layout_weight="4"
            android:layout_height="wrap_content"
            android:text="Current Period"
            android:gravity="center"
            android:fontFamily="@font/quicksand_medium"
            android:textSize="18sp"
            android:letterSpacing="0.1"
            />
        <ImageView
            android:visibility="invisible"
            android:id="@+id/warningSignalId2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/danger_triangle_svgrepo_com"
            app:tint="@color/white" />
    </LinearLayout>

    <TextView
        android:layout_marginTop="8dp"
        android:id="@+id/SpendTitleId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Spend"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:maxLines="1"
        android:letterSpacing="0.1"
        app:drawableEndCompat="@drawable/baseline_remove_24"
        android:drawablePadding="8dp"
        app:drawableTint="@color/icon_color_primary"
        app:layout_constraintTop_toBottomOf="@id/currentPeriodId"
        app:layout_constraintRight_toRightOf="@id/TransferFromTitleId"
        />

    <ImageView
        android:id="@+id/warningSignalId"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintTop_toTopOf="@id/SpendTitleValueId"
        app:layout_constraintRight_toLeftOf="@id/SpendTitleValueId"
        app:layout_constraintBottom_toBottomOf="@id/SpendTitleValueId"
        android:src="@drawable/danger_triangle_svgrepo_com"
        app:tint="@color/white" />
    <TextView
        android:layout_marginHorizontal="16dp"
        android:id="@+id/SpendTitleValueId"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="1250012345"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:maxLines="1"
        android:letterSpacing="0.15"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/SpendTitleId"
        app:layout_constraintBottom_toBottomOf="@id/SpendTitleId"
        android:minEms="7"
        android:gravity="center_vertical|end"
        android:background="@color/tv_report_card_bg"
        android:textSize="16sp"
        />
    <TextView

        android:id="@+id/EarnedTitleId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Earned"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:maxLines="1"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/SpendTitleId"
        app:layout_constraintRight_toRightOf="@id/TransferFromTitleId"
        app:drawableEndCompat="@drawable/baseline_add_24"
        android:drawablePadding="8dp"
        android:drawableTint="@color/icon_color_primary"
        />
    <TextView
        android:id="@+id/EarnedTitleValueId"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_margin="0dp"
        android:text="1250"
        android:textSize="16sp"
        android:layout_marginHorizontal="8dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:minEms="7"
        android:gravity="center_vertical|end"
        android:maxLines="1"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toTopOf="@id/EarnedTitleId"
        app:layout_constraintRight_toRightOf="@id/SpendTitleValueId"
        app:layout_constraintLeft_toLeftOf="@id/SpendTitleValueId"
        app:layout_constraintBottom_toBottomOf="@id/EarnedTitleId"
        android:background="@color/tv_report_card_bg"
        />
    <TextView
        android:id="@+id/TransferToTitleId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transfer To"
        android:layout_marginHorizontal="8dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:maxLines="1"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/EarnedTitleId"
        app:layout_constraintRight_toRightOf="@id/TransferFromTitleId"
        app:drawableEndCompat="@drawable/baseline_remove_24"
        android:drawablePadding="8dp"
        android:layout_margin="0dp"
        android:drawableTint="@color/icon_color_primary"
        />
    <TextView
        android:id="@+id/TransferToTitleValueId"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="1250"
        android:layout_marginHorizontal="8dp"
        android:textSize="16sp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:maxLines="1"
        android:minEms="7"
        android:gravity="center_vertical|end"
        android:letterSpacing="0.15"
        android:background="@color/tv_report_card_bg"
        app:layout_constraintTop_toTopOf="@id/TransferToTitleId"
        app:layout_constraintRight_toRightOf="@id/SpendTitleValueId"
        app:layout_constraintLeft_toLeftOf="@id/SpendTitleValueId"
        app:layout_constraintBottom_toBottomOf="@id/TransferToTitleId"
        />
    <TextView

        android:id="@+id/TransferFromTitleId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transfer From"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:maxLines="1"
        android:layout_marginHorizontal="16dp"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/TransferToTitleId"
        app:layout_constraintLeft_toLeftOf="parent"
        app:drawableEndCompat="@drawable/baseline_add_24"
        android:drawablePadding="8dp"
        android:drawableTint="@color/icon_color_primary"
        />
    <TextView
        android:id="@+id/TransferFromTitleValueId"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="125"
        android:layout_marginHorizontal="8dp"
        android:textSize="16sp"
        android:minEms="7"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:maxLines="1"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toTopOf="@id/TransferFromTitleId"
        app:layout_constraintRight_toRightOf="@id/SpendTitleValueId"
        android:background="@color/tv_report_card_bg"
        app:layout_constraintLeft_toLeftOf="@id/SpendTitleValueId"
        app:layout_constraintBottom_toBottomOf="@id/TransferFromTitleId"
        />
    <ImageView
        android:id="@+id/sumDividerId"
        android:layout_width="0dp"
        android:layout_height="10dp"
        app:layout_constraintStart_toStartOf="@id/SpendTitleValueId"
        app:layout_constraintEnd_toEndOf="@id/SpendTitleValueId"
        app:layout_constraintTop_toBottomOf="@id/TransferFromTitleValueId"
        android:src="@drawable/dashed_line" />
    <TextView
        android:id="@+id/finalSumValueId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="125"
        android:textSize="16sp"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:maxLines="1"
        android:letterSpacing="0.15"
        android:textColor="@color/tv_report_card_sum_font_color"
        app:drawableStartCompat="@drawable/baseline_add_24"
        app:drawableTint="@color/tv_report_card_sum_font_color"
        app:layout_constraintTop_toBottomOf="@id/sumDividerId"
        app:layout_constraintRight_toRightOf="@id/SpendTitleValueId" />

    <TextView
        android:id="@+id/recyclerViewTitleId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:padding="4dp"
        android:layout_marginVertical="4dp"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/finalSumValueId"
        app:layout_constraintLeft_toLeftOf="parent"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:text="Favorite"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/presetRecyclerViewId"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="4dp"
        android:layout_marginHorizontal="4dp"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recyclerViewTitleId"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView
        android:visibility="visible"
        android:id="@+id/placeholderPresetImageViewId"
        android:src="@drawable/_195527_3169208"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="64dp"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recyclerViewTitleId"
        app:layout_constraintBottom_toBottomOf="parent"/>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/buttonId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/button_bg_default"
        app:srcCompat="@drawable/baseline_add_24"
        app:tint="@color/button_icon_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/allCategoryRecordId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:fabSize="mini"
        app:fabCustomSize="40dp"
        app:srcCompat="@drawable/baseline_assignment_24"
        app:tint="@color/button_icon_color"
        android:backgroundTint="@color/button_bg_default"
        app:layout_constraintTop_toTopOf="@id/buttonId"
        app:layout_constraintBottom_toBottomOf="@id/buttonId"
        app:layout_constraintLeft_toRightOf="@id/buttonId"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fullRecordId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:fabSize="mini"
        app:fabCustomSize="40dp"
        app:srcCompat="@drawable/baseline_format_list_bulleted_24"
        app:tint="@color/button_icon_color"
        android:backgroundTint="@color/button_bg_default"
        app:layout_constraintTop_toTopOf="@id/buttonId"
        app:layout_constraintBottom_toBottomOf="@id/buttonId"
        app:layout_constraintRight_toLeftOf="@id/buttonId" />

</androidx.constraintlayout.widget.ConstraintLayout>