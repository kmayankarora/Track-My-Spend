<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@+id/categoryTitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingVertical="2dp"
        app:layout_constraintHorizontal_bias="0.00"
        android:text="Category Name"
        android:textSize="16sp"
        android:ellipsize="end"
        app:layout_constraintTop_toTopOf="@id/categoryIconImageView"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/categoryIconImageView"
        app:layout_constraintBottom_toTopOf="@id/monthlyLimitId"
        android:layout_marginHorizontal="6dp"
        android:textColor="@color/normal_text_color"
        />
    <TextView
        android:id="@+id/monthlyLimitId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="123456"
        android:paddingVertical="2dp"
        android:textSize="12sp"
        android:gravity="center_vertical"
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:textColor="@color/normal_text_color"
        app:drawableStartCompat="@drawable/rupee_sign_svgrepo_com_12px"
        app:drawableTint="@color/icon_color_primary"
        app:layout_constraintStart_toStartOf="@id/categoryTitleTextView"
        app:layout_constraintTop_toBottomOf="@id/categoryTitleTextView"
        app:layout_constraintBottom_toBottomOf="@id/categoryIconImageView"/>
    <ImageView
        android:id="@+id/categoryIconImageView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:lines="1"
        android:maxLines="1"
        android:src="@drawable/circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="0dp"
        app:tint="@color/fab_bg_color" />

</androidx.constraintlayout.widget.ConstraintLayout>