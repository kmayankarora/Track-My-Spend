<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:fontFamily="@font/quicksand_medium"
        android:letterSpacing="0.1"
        android:id="@+id/categoryTitleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Category Title"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:maxLines="1"
        android:minEms="10"
        android:maxLength="25"
        android:ellipsize="end"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="@id/amountValueId"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/dateValueId"
        app:layout_constraintBottom_toBottomOf="@id/amountValueId"/>
    <TextView
        android:id="@+id/amountValueId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="125001"
        android:paddingEnd="8dp"
        android:paddingStart="4dp"
        android:paddingVertical="4dp"
        android:maxLines="1"
        android:letterSpacing="0.125"
        android:minEms="5"
        android:gravity="center_vertical|end"
        android:textSize="16sp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
    <ImageView
        android:padding="2dp"
        android:id="@+id/signDrawableId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_add_24"
        app:tint="@color/icon_color_primary"
        app:layout_constraintTop_toTopOf="@id/amountValueId"
        app:layout_constraintRight_toLeftOf="@id/amountValueId"
        app:layout_constraintBottom_toBottomOf="@id/amountValueId"/>
    <TextView
        android:id="@+id/dateValueId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25/01"
        android:fontFamily="@font/quicksand_medium"
        android:paddingHorizontal="2dp"
        android:paddingVertical="4dp"
        android:maxLines="1"
        android:gravity="center"
        android:textSize="14sp"
        app:layout_constraintRight_toLeftOf="@id/signDrawableId"
        app:layout_constraintTop_toTopOf="@id/amountValueId"
        app:layout_constraintBottom_toBottomOf="@id/amountValueId"/>
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/amountValueId"
        android:paddingTop="6dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
