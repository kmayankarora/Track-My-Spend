<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="4dp"
    android:paddingVertical="2dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/categoryImageView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:lines="1"
        android:maxLines="1"
        android:src="@drawable/circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toTopOf="@id/divider"
        android:layout_margin="4dp"
        app:tint="@color/fab_bg_color" />

    <LinearLayout
        android:id="@+id/firstRowLayout1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toRightOf="@id/categoryImageView">

        <TextView
            android:id="@+id/transactionTypeEntryId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="@font/quicksand_medium"
            android:letterSpacing="0.1"
            android:layout_marginStart="8dp"
            android:layout_marginVertical="2dp"
            android:text="transfer to "
            android:ellipsize="end"
            android:background="@drawable/rectangle_shape"
            android:backgroundTint="@color/edittext_special_bg_color"
            android:textSize="12sp"
            android:textColor="@color/normal_text_color"
            android:layout_gravity="center"
            />
        <TextView
            android:id="@+id/transferToFromPersonId"
            android:ellipsize="end"
            android:text="123456789abcedfeffefa"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:lines="1"
            android:textSize="12sp"
            android:textColor="@color/normal_text_color"
            android:paddingStart="4dp"
            android:fontFamily="@font/quicksand_medium"
            android:letterSpacing="0.1"
            android:layout_gravity="center"
            android:gravity="center"
            />

        <TextView
            android:id="@+id/amountTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="@font/quicksand_medium"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="12345678"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@drawable/rupee_sign_svgrepo_com_12px"
            app:drawableTint="@color/icon_color_primary"
            android:layout_margin="2dp"
            android:textSize="18sp"
            android:textColor="@color/normal_text_color"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/secondRowLayout2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintLeft_toRightOf="@id/categoryImageView"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/firstRowLayout1">

        <TextView
            android:id="@+id/categoryTextView"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:lines="1"
            android:fontFamily="@font/quicksand_medium"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:text="Category Name is so yeah and meh and blah blha blah"
            android:layout_marginVertical="2dp"
            android:layout_marginHorizontal="8dp"
            android:drawablePadding="8dp"
            android:ellipsize="end"
            android:gravity="center|start"
            android:textColor="@color/normal_text_color"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="@id/transactionTypeEntryId"
            app:layout_constraintTop_toBottomOf="@id/transactionTypeEntryId"
            />

        <TextView
            android:id="@+id/timeOfEntryId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:text="15:06"
            android:fontFamily="@font/quicksand_medium"
            android:letterSpacing="0.1"
            android:textSize="12sp"
            android:gravity="center"
            app:layout_constraintRight_toRightOf="@id/amountTextView"
            app:layout_constraintLeft_toRightOf="@id/categoryTextView"
            app:layout_constraintTop_toBottomOf="@id/amountTextView"
            app:layout_constraintBaseline_toBaselineOf="@id/categoryTextView"
            app:layout_constraintHorizontal_bias="1"
            android:textColor="@color/normal_text_color"
            />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/yellow"
        android:paddingTop="4dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/secondRowLayout2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@id/secondRowLayout2"
        app:layout_constraintRight_toRightOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>