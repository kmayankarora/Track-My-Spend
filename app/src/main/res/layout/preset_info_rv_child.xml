<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView android:layout_margin="2dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    app:cardCornerRadius="4dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:background="@color/card_view_normal_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/presetNameId"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Favorite Name"
                android:textStyle="bold"
                android:fontFamily="@font/quicksand_medium"
                android:letterSpacing="0.025"
                android:padding="2dp"
                android:textColor="@color/card_view_font_color"
                android:layout_marginVertical="2dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:ellipsize="end"/>
            <TextView
                android:id="@+id/amountId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12345"
                android:textStyle="italic"
                android:gravity="center_vertical"
                android:textColor="@color/card_view_font_color"
                android:drawablePadding="4dp"
                android:padding="2dp"
                android:maxLength="10"
                android:fontFamily="@font/quicksand_medium"
                android:letterSpacing="0.1"
                android:layout_marginVertical="2dp"
                app:drawableStartCompat="@drawable/rupee_sign_svgrepo_com_12px"
                app:drawableTint="@color/icon_color_primary" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/expenseTypeId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spend"
                android:gravity="center_vertical"
                android:fontFamily="@font/quicksand_medium"
                android:letterSpacing="0.025"
                android:textColor="@color/card_view_font_color"
                android:padding="2dp"
                app:layout_constraintTop_toBottomOf="@id/presetNameId"
                app:layout_constraintLeft_toLeftOf="@id/presetNameId"/>
            <TextView
                android:id="@+id/transferTypeId"
                android:layout_width="wrap_content"
                android:textColor="@color/card_view_font_color"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="To"
                android:paddingVertical="2dp"
                android:fontFamily="@font/quicksand_medium"
                android:letterSpacing="0.025"
                app:layout_constraintBaseline_toBaselineOf="@id/expenseTypeId"
                app:layout_constraintLeft_toRightOf="@id/expenseTypeId"/>
            <TextView
                android:id="@+id/transferPersonId"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:textColor="@color/card_view_font_color"
                android:text="Mayank"
                android:paddingVertical="2dp"
                android:paddingHorizontal="4dp"
                android:maxLength="20"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/quicksand_medium"
                android:letterSpacing="0.025"
                app:layout_constraintBaseline_toBaselineOf="@id/expenseTypeId"
                app:layout_constraintLeft_toRightOf="@id/transferTypeId"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/categoryTypeId"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:layout_height="wrap_content"
                android:text="Category"
                android:padding="2dp"
                android:fontFamily="@font/quicksand_medium"
                android:letterSpacing="0.025"
                android:ellipsize="end"
                android:maxLength="16"
                android:textColor="@color/card_view_font_color" />
            <ImageView
                android:id="@+id/iconImageView"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/circle_icon"
                android:backgroundTint="@color/fab_bg_color"
                />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>